# ── Supabase (백엔드 전용 · 절대 클라이언트에 노출 금지) ────────────────
SUPABASE_URL=https://dkuwhglayyzawmetbkbh.supabase.co
# Supabase 대시보드 > Project Settings > API Keys > service_role 값을 넣어주세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# 이 키가 쓸 수 있는 채팅 모델. moderation 모델 권한이 없으면
# 검열 4단계를 이 모델이 대신 수행한다 (lib/moderation.ts).
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MODERATION_MODEL=omni-moderation-latest

# ── 선택 ──────────────────────────────────────────────────────────────
# 프론트를 다른 오리진에서 띄울 때만 설정 (예: http://localhost:5173)
CORS_ALLOW_ORIGIN=

# 프로젝트 추천 활성화에 필요한 최소 '관심(오른쪽 스와이프)' 수 (프론트 화면 문구와 같은 값)
PROJECT_MIN_LIKES=3

# 카드 덱 1회 요청 시 기본 장수 (1~5번은 트렌드 키워드로 즉시)
CARD_DECK_SIZE=5

# ── 네이버 데이터랩 (트렌드 키워드) ──────────────────────────────────
# 없어도 동작합니다 — 없으면 seed_keywords 의 기본 점수 순서로 떨어집니다.
# https://developers.naver.com/apps  에서 애플리케이션 등록 후
# '데이터랩 (검색어 트렌드)' API 를 추가하면 발급됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 미리 만들어 둘 카드 장수. 4 = "2번 카드를 볼 때 6번 카드를 만든다"
CARD_LOOKAHEAD=4

# 룩어헤드가 모자랄 때 한 번에 만들 카드 수 (AI 호출 횟수를 줄인다)
CARD_REFILL_BATCH=5
